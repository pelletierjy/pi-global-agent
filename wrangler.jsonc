{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-global-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  // nodejs_compat: process.env for provider API keys (pi-ai reads e.g. DEEPSEEK_API_KEY)
  // global_fetch_strictly_public: /federation fetches peer workers over the public
  // internet — without it, same-zone worker-to-worker fetch() fails with 1042.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // One Durable Object (SQLite-backed; Pi Durable harness + mission-control tables).
  "durable_objects": {
    "bindings": [{ "name": "PiAgent", "class_name": "PiAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiAgent"] }],

  // Custom domains (pi-global-agent.jyp.solutions): requires the jyp.solutions zone on this
  // Cloudflare account (delegate NS to the assigned Cloudflare pi-global-agentservers first).
  // When active, re-add and redeploy:
  // "routes": [{ "pattern": "pi-global-agent.jyp.solutions", "custom_domain": true }],

  // Scenario C: weekly sweep (Mondays 13:00 UTC = 09:00 EDT): digests every peer's
  // queue into a hub note and dispatches SWEEP_TASK (deduped) on each peer.
  "triggers": { "crons": ["0 13 * * 1", "0 5 * * *"] },

  "vars": {
    "AGENT_NAME": "global",
    // Hub only: the four project workers. Switch URLs to *.jyp.solutions once
    // the zone is active.
    "SWEEP_TASK": "Weekly audit: verify the project builds and tests pass (use run_command where useful), then add a note with any failures", "PEERS": "[{\"name\":\"conversia-core\",\"url\":\"https://pi-conversia-core.need-homework.workers.dev\"},{\"name\":\"homeworktutora\",\"url\":\"https://pi-homeworktutora.need-homework.workers.dev\"},{\"name\":\"scalesviewer\",\"url\":\"https://pi-scalesviewer.need-homework.workers.dev\"},{\"name\":\"globalvsthost\",\"url\":\"https://pi-globalvsthost.need-homework.workers.dev\"}]"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

